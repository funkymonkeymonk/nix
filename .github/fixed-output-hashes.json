{
  "targets": [
    {
      "name": "bifrost-ui-npm-deps",
      "buildTarget": ".#packages.x86_64-linux.bifrost-ui",
      "file": "overlays/default.nix",
      "start": "bifrost-ui =",
      "field": "hash",
      "bootstrap": "final.lib.fakeHash"
    },
    {
      "name": "bifrost-http-go-modules",
      "derivationPattern": "^bifrost-http-(go-modules|vendor)$",
      "buildTarget": ".#packages.x86_64-linux.bifrost-http",
      "file": "overlays/default.nix",
      "start": "bifrost-http =",
      "field": "vendorHash",
      "bootstrap": "final.lib.fakeHash"
    }
  ]
}
