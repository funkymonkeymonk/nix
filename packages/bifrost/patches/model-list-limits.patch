diff --git a/framework/modelcatalog/model_metadata.go b/framework/modelcatalog/model_metadata.go
new file mode 100644
index 0000000..07af2a4
--- /dev/null
+++ b/framework/modelcatalog/model_metadata.go
@@ -0,0 +1,71 @@
+package modelcatalog
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/maximhq/bifrost/core/schemas"
+)
+
+const modelMetadataFileEnv = "BIFROST_MODEL_METADATA_FILE"
+
+// ModelMetadata declares limits for a model that does not report them itself.
+type ModelMetadata struct {
+	ContextLength   *int `json:"context_length,omitempty"`
+	MaxOutputTokens *int `json:"max_output_tokens,omitempty"`
+}
+
+func loadModelMetadataFromEnv() (map[string]ModelMetadata, error) {
+	path := strings.TrimSpace(os.Getenv(modelMetadataFileEnv))
+	if path == "" {
+		return nil, nil
+	}
+
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read %s: %w", modelMetadataFileEnv, err)
+	}
+	var configured map[string]ModelMetadata
+	if err := json.Unmarshal(data, &configured); err != nil {
+		return nil, fmt.Errorf("parse %s: %w", modelMetadataFileEnv, err)
+	}
+
+	metadata := make(map[string]ModelMetadata, len(configured))
+	for modelID, limits := range configured {
+		key := strings.ToLower(strings.TrimSpace(modelID))
+		if key == "" {
+			return nil, fmt.Errorf("%s contains an empty model ID", modelMetadataFileEnv)
+		}
+		if _, exists := metadata[key]; exists {
+			return nil, fmt.Errorf("%s contains duplicate model ID %q", modelMetadataFileEnv, modelID)
+		}
+		if limits.ContextLength != nil && *limits.ContextLength <= 0 {
+			return nil, fmt.Errorf("%s context_length for %q must be positive", modelMetadataFileEnv, modelID)
+		}
+		if limits.MaxOutputTokens != nil && *limits.MaxOutputTokens <= 0 {
+			return nil, fmt.Errorf("%s max_output_tokens for %q must be positive", modelMetadataFileEnv, modelID)
+		}
+		metadata[key] = limits
+	}
+	return metadata, nil
+}
+
+func (mc *ModelCatalog) applyLocalModelMetadata(model *schemas.Model) {
+	if mc == nil || model == nil || len(mc.modelMetadata) == 0 {
+		return
+	}
+	metadata, ok := mc.modelMetadata[strings.ToLower(strings.TrimSpace(model.ID))]
+	if !ok {
+		return
+	}
+	if model.ContextLength == nil && model.MaxInputTokens == nil && metadata.ContextLength != nil {
+		contextLength := *metadata.ContextLength
+		model.ContextLength = &contextLength
+	}
+	if model.MaxOutputTokens == nil && metadata.MaxOutputTokens != nil {
+		maxOutputTokens := *metadata.MaxOutputTokens
+		model.MaxOutputTokens = &maxOutputTokens
+	}
+}
