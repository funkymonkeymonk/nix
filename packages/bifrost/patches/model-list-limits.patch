new file mode 100644
index 0000000..3603a33
--- /dev/null
+++ b/framework/modelcatalog/modelmetadata_test.go
@@ -0,0 +1,70 @@
+package modelcatalog
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	bifrost "github.com/maximhq/bifrost/core"
+	"github.com/maximhq/bifrost/core/schemas"
+)
+
+func TestInitLoadsLocalModelMetadataAndBackfillsOnlyMissingLimits(t *testing.T) {
+	tempDir := t.TempDir()
+	metadataPath := filepath.Join(tempDir, "model-metadata.json")
+	metadataJSON := []byte(`{
+		"omlx/qwen3.8-27b": {
+			"context_length": 128000,
+			"max_output_tokens": 30720
+		}
+	}`)
+	if err := os.WriteFile(metadataPath, metadataJSON, 0o600); err != nil {
+		t.Fatalf("write model metadata: %v", err)
+	}
+	t.Setenv("BIFROST_MODEL_METADATA_FILE", metadataPath)
+
+	pricingPath := filepath.Join(tempDir, "pricing.json")
+	if err := os.WriteFile(pricingPath, []byte(`{}`), 0o600); err != nil {
+		t.Fatalf("write pricing fixture: %v", err)
+	}
+	paramsPath := filepath.Join(tempDir, "model-parameters.json")
+	if err := os.WriteFile(paramsPath, []byte(`{}`), 0o600); err != nil {
+		t.Fatalf("write model parameters fixture: %v", err)
+	}
+
+	catalog, err := Init(t.Context(), &Config{
+		PricingURL:             schemas.Ptr("file://" + pricingPath),
+		ModelParametersURL:     schemas.Ptr("file://" + paramsPath),
+		MCPLibrarySyncInterval: schemas.Ptr(int64(MCPLibrarySyncDisabled)),
+	}, nil, bifrost.NewNoOpLogger())
+	if err != nil {
+		t.Fatalf("initialize model catalog: %v", err)
+	}
+	defer catalog.Cleanup()
+
+	missing := &schemas.BifrostListModelsResponse{
+		Data: []schemas.Model{{ID: "omlx/qwen3.8-27b"}},
+	}
+	catalog.EnrichListModelsResponse(missing)
+	if got := missing.Data[0].ContextLength; got == nil || *got != 128000 {
+		t.Errorf("ContextLength = %v, want 128000", got)
+	}
+	if got := missing.Data[0].MaxOutputTokens; got == nil || *got != 30720 {
+		t.Errorf("MaxOutputTokens = %v, want 30720", got)
+	}
+
+	providerReported := &schemas.BifrostListModelsResponse{
+		Data: []schemas.Model{{
+			ID:              "omlx/qwen3.8-27b",
+			ContextLength:   schemas.Ptr(65536),
+			MaxOutputTokens: schemas.Ptr(4096),
+		}},
+	}
+	catalog.EnrichListModelsResponse(providerReported)
+	if got := providerReported.Data[0].ContextLength; got == nil || *got != 65536 {
+		t.Errorf("provider ContextLength = %v, want preserved 65536", got)
+	}
+	if got := providerReported.Data[0].MaxOutputTokens; got == nil || *got != 4096 {
+		t.Errorf("provider MaxOutputTokens = %v, want preserved 4096", got)
+	}
+}
